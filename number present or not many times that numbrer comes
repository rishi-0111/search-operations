import java.util.*;

class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int a[] = new int[n];

        // Input array
        for (int i = 0; i < n; i++) {
            a[i] = sc.nextInt();
        }

        // Number to search
        int key = sc.nextInt();

        int count = 0;

        // Search and count occurrences
        for (int i = 0; i < n; i++) {
            if (a[i] == key) {
                count++;
            }
        }

        // Output
        if (count > 0) {
            System.out.println("Found");
            System.out.println("Occurrences = " + count);
        } else {
            System.out.println("Not Found");
        }
    }
}
