import java.util.*;
class Main{
    public static void Main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int a[]=new int[n];
        for(int i=0;i<n;i++){
            a[i]=sc.nextInt();
        }
        int key=sc.nextInt();
        int c=0;
        for(int i=0;i<n;i++){
            if(a[i]==key){
                c++;
            }
        }
        
         
        if(c<0)System.out.print("found");
        else System.out.print("not found");
    }
